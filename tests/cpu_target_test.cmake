execute_process(COMMAND "${LINK_TEST}" --runner "${RUNNER}" --core "${CORE}"
    --rom "${ROM}" --out "${OUT}" --frames 8
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(REFUSE)
    if(rc EQUAL 0 OR NOT "${output}${errors}" MATCHES "frame this link cannot carry")
        message(FATAL_ERROR "mismatched CPU loan was not refused: ${rc}\n${output}\n${errors}")
    endif()
    return()
endif()
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "CPU-target link run failed: ${rc}\n${output}\n${errors}")
endif()
foreach(expected "8 frame(s) granted and done, runner exit 0, 0 fault(s)"
                 "pictures received: 7" "picture: first byte 8")
    string(FIND "${output}" "${expected}" pos)
    if(pos EQUAL -1)
        message(FATAL_ERROR "missing CPU-target result: ${expected}\n${output}")
    endif()
endforeach()
file(READ "${OUT}/core.log" log)
string(FIND "${log}" "FAKE_CPU_TARGET acquired=8 previous=7 abandoned=1" pos)
if(pos EQUAL -1)
    message(FATAL_ERROR "CPU-target history/expiry checks did not execute: ${log}")
endif()
