# Actual linked runner: compact/repeat, unadvertised fallback, and recorder fallback.
foreach(mode compact fallback record)
    set(args --cpu-pixel-pairs-test --unpaced --pcm-hash)
    set(envargs)
    if(NOT mode STREQUAL fallback)
        list(APPEND args --cpu-pixel-pairs)
    endif()
    if(mode STREQUAL record)
        list(APPEND envargs "RETRO_RECORD_ROUTE=${OUT}/pairs.route")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${envargs}
        "${LINK_TEST}" --runner "${RUNNER}" --core "${CORE}" --rom "${ROM}"
        --out "${OUT}/${mode}" --frames 8 ${args}
        RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT rc EQUAL 0 OR NOT output MATCHES "8 frame.s. granted and done, runner exit 0, 0 fault.s.")
        message(FATAL_ERROR "${mode} pixel-pair fields failed: ${rc}\n${output}\n${errors}")
    endif()
    file(READ "${OUT}/${mode}/core.log" log)
    if(mode STREQUAL compact)
        if(NOT log MATCHES "FAKE_CPU_REPEAT repeats=3" OR NOT output MATCHES "pictures received: 5")
            message(FATAL_ERROR "compact path/repeat not selected: ${output} ${log}")
        endif()
    elseif(NOT log MATCHES "FAKE_CPU_REPEAT repeats=0" OR NOT output MATCHES "pictures received: 8")
        message(FATAL_ERROR "${mode} fallback did not publish ordinary images: ${output} ${log}")
    endif()
    file(SHA256 "${OUT}/${mode}/shot.ppm" shot)
    string(REGEX MATCH "PCM_HASH [0-9a-f]+ over 32 samples" pcm "${output}")
    if(mode STREQUAL compact)
        set(reference_shot "${shot}")
        set(reference_pcm "${pcm}")
    elseif(NOT shot STREQUAL reference_shot OR NOT pcm STREQUAL reference_pcm)
        message(FATAL_ERROR "${mode} changed final picture/audio")
    endif()
endforeach()
execute_process(COMMAND "${RUNNER}" --core "${CORE}" --rom "${ROM}"
    --play-route "${OUT}/pairs.route" --out "${OUT}/play"
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "compact recorder fallback replay failed: ${rc} ${output} ${errors}")
endif()
file(READ "${OUT}/play/route-verdict.json" verdict)
if(NOT verdict MATCHES "in_sync")
    message(FATAL_ERROR "compact recorder fallback replay diverged: ${verdict}")
endif()
